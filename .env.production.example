# =============================================================================
# Production environment template
#
# Use this as the source when filling in the "Environment" section of the
# Dokploy Application UI. Do NOT commit a real .env.production with secrets.
# Anything wrapped in <...> must be replaced before deploy.
# =============================================================================

APP_NAME=Profiltech
APP_ENV=production
APP_KEY=<run "php artisan key:generate --show" locally and paste the base64:... value here>
APP_DEBUG=false
APP_URL=https://api.profiltech.dk

# URL of the Nuxt frontend (used by Laravel for redirects, password reset links, etc.)
FRONTEND_URL=https://app.profiltech.dk

# Sanctum: hosts (no protocol, no trailing slash) that are allowed to use
# stateful cookie-based auth. Multiple domains comma-separated.
SANCTUM_STATEFUL_DOMAINS=app.profiltech.dk

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging — write to stderr so Docker / Dokploy collect via `docker logs`
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database — points at the Dokploy MariaDB service by its service name
# -----------------------------------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=<mariadb-service-name>
DB_PORT=3306
DB_DATABASE=profiltech
DB_USERNAME=profiltech
DB_PASSWORD=<strong-password>

# -----------------------------------------------------------------------------
# Sessions — cookies must be sent across the api/app subdomain pair.
# Leading dot on SESSION_DOMAIN makes the cookie valid for *.profiltech.dk.
# -----------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.profiltech.dk
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Queue — Horizon runs against Redis
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=redis
HORIZON_PREFIX=profiltech_horizon:

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=<redis-service-name>
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Octane — long-running PHP via FrankenPHP worker mode
# -----------------------------------------------------------------------------
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=true
FRANKENPHP_NUM_THREADS=4

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-pass>
MAIL_FROM_ADDRESS=no-reply@profiltech.dk
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# S3 (only if file uploads go to S3 — otherwise leave blank and use local disk
# with a mounted Dokploy volume on /app/storage/app)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Domain-specific (carry over from existing .env)
# -----------------------------------------------------------------------------
WOOCOMMERCE_BASE_URL=<woocommerce-url>
WOOCOMMERCE_CONSUMER_KEY=<key>
WOOCOMMERCE_CONSUMER_SECRET=<secret>
WOOCOMMERCE_WEBHOOK_SECRET=<webhook-secret>

CUSTOM_ORDER_CC_EMAIL=<cc-email>
CUSTOM_ORDER_REPLY_TO=hanne@profiltech.dk
